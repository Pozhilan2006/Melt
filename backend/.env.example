# Application Environment Variables Example

# Database Connection (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://melt_user:melt_password@localhost:5432/melt_db

# Security & Authentication
JWT_SECRET_KEY=generate-a-long-random-secret-and-store-it-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]
